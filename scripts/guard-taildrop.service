[Unit]
Description=Receive Tailscale Taildrop files for Guard
After=tailscaled.service
Wants=tailscaled.service

[Service]
Type=simple
WorkingDirectory=/root/guard
ExecStart=/usr/bin/tailscale file get --loop --conflict=rename /root/guard/taildrop
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
